bots:
  - id: financials-xlf
    name: "Financials · XLF"
    base_url: "http://127.0.0.1:8780"
    signals_path: "/signals"
    api_key_env: "FINANCIALS_XLF_API_KEY"
    enabled: true

  - id: reversal-watchlist
    name: "Reversal · Crowding"
    base_url: "http://127.0.0.1:8781"
    signals_path: "/signals"
    api_key_env: "REVERSAL_WATCHLIST_API_KEY"
    enabled: true

  - id: candlestick-patterns
    name: "Candlestick · Pattern Finder"
    base_url: "http://127.0.0.1:8782"
    signals_path: "/signals"
    api_key_env: "CANDLESTICK_PATTERNS_API_KEY"
    enabled: true

  - id: technology-xlk
    name: "Technology XLK"
    base_url: "http://127.0.0.1:8783"
    signals_path: "/signals"
    api_key_env: "TECHNOLOGY_XLK_API_KEY"
    enabled: true
