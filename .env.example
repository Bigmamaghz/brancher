# Alpaca paper only
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional override — must be paper endpoint (live URLs are refused)
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sizing & risk
ALPACA_PAPER_QTY=1
ALPACA_PAPER_QTY_MAX_MULT=4
MAX_OPEN_POSITIONS=10
MAX_OPENS_PER_DAY=5
MIN_HIT=0.75

# Telegram: ONLY real news + trades. No status / FAIL / 15-min spam.
TELEGRAM_NEWS_ONLY=1
TELEGRAM_TRADES_ONLY=0
TELEGRAM_EOD=0

# Author API keys (one per bot in config/bots.yaml)
FINANCIALS_XLF_API_KEY=
CANDLESTICK_PATTERNS_API_KEY=
TECHNOLOGY_XLK_API_KEY=
